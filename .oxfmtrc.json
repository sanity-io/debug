{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "tabWidth": 2,
  "printWidth": 100,
  "proseWrap": "never",
  "semi": false,
  "singleQuote": true,
  "quoteProps": "consistent",
  "bracketSpacing": false,
  "ignorePatterns": [".changeset/*.md", "CHANGELOG.md"]
}
